---
import { Icon } from "astro-icon/components";
import { navBarConfig, profileConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const isCurrentLink = (link: NavBarLink) => {
	if (link.external) return false;
	const targetPath = url(link.url);
	if (link.url === "/articles/") {
		return (
			Astro.url.pathname === targetPath ||
			Astro.url.pathname.startsWith(targetPath)
		);
	}
	return pathsEqual(Astro.url.pathname, targetPath);
};
---
<div id="navbar" class="z-50">
    <div class:list={[
        className,
        "navbar-surface card-base !overflow-visible max-w-[var(--page-width)] h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4"]}>
        <a href={url('/')} aria-label={siteConfig.title} class="navbar-control btn-plain scale-animation rounded-lg h-[3.25rem] px-3 sm:px-5 font-bold active:scale-95">
            <div class="navbar-brand flex flex-row text-[var(--primary)] items-center text-md whitespace-nowrap">
                <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                <span class="hidden sm:inline">{siteConfig.title}</span>
                <span class="sm:hidden">{profileConfig.name}</span>
            </div>
        </a>
        <div class="hidden md:flex">
            {links.map((l) => {
                const current = isCurrentLink(l);
                const targetPath = l.external ? undefined : url(l.url);
                return <a aria-label={l.name} aria-current={current ? "page" : undefined} href={l.external ? l.url : targetPath}
                          target={l.external ? "_blank" : null} rel={l.external ? "noopener noreferrer" : undefined}
                          data-nav-link={l.external ? undefined : "true"}
                          data-nav-path={targetPath}
                          data-nav-match={l.url === "/articles/" ? "prefix" : "exact"}
                          class:list={["navbar-control btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95", {"nav-link-current": current}]}
                >
                    <div class="flex items-center">
                        {l.name}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="navbar-external-icon text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="navbar-control btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
            <button aria-label="Menu" name="Nav Menu" class="navbar-control btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 md:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={links}></NavMenuPanel>
        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<style is:global>
#navbar .navbar-surface {
    height: 4rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0.5rem !important;
    background: rgba(18, 29, 50, 0.36) !important;
    box-shadow: 0 12px 32px rgba(4, 10, 22, 0.22);
}

#navbar .navbar-control,
#navbar #search-switch,
#navbar #scheme-switch {
    --btn-plain-bg-hover: rgba(255, 255, 255, 0.16);
    --btn-plain-bg-active: rgba(255, 255, 255, 0.22);
    color: rgba(255, 255, 255, 0.96) !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.85), 0 0 12px rgba(0, 0, 0, 0.55);
}

#navbar .navbar-brand {
    color: rgba(255, 255, 255, 0.96) !important;
}

#navbar .navbar-control svg,
#navbar #search-switch svg,
#navbar #scheme-switch svg,
#navbar #search-bar svg {
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.72));
}

#navbar .navbar-external-icon {
    color: rgba(255, 255, 255, 0.82) !important;
}

#navbar .nav-link-current {
    color: rgba(255, 255, 255, 0.96) !important;
    background: rgba(255, 255, 255, 0.12);
}

#navbar .nav-link-current::before {
    transform: scale(1);
    background: var(--btn-plain-bg-hover);
}

#navbar #search-bar {
    background: rgba(255, 255, 255, 0.12) !important;
}

#navbar #search-bar:hover,
#navbar #search-bar:focus-within {
    background: rgba(255, 255, 255, 0.18) !important;
}

#navbar #search-bar input,
#navbar #search-bar svg {
    color: rgba(255, 255, 255, 0.96) !important;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
}

#navbar #search-bar input::placeholder {
    color: rgba(255, 255, 255, 0.88);
}

@media (max-width: 639px) {
    #navbar .navbar-surface {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
    }
}
</style>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
